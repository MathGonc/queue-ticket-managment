# Configuracao do backend (modo standalone / desenvolvimento).
# Copie para backend/.env  -- o infra\standalone\setup.cmd faz isso sozinho
# e gera um JWT_SECRET aleatorio. No Docker este arquivo NAO e usado
# (veja infra/docker/.env.example).

# MongoDB local
DB_IP=127.0.0.1:27017
DB_NAME=gonc-queue-manager
# Deixe vazios se o MongoDB nao usa autenticacao (mongod sem --auth).
# Se usa, informe um usuario com acesso (authSource=admin).
DB_USER=
DB_PASS=

PORT=3030

# Obrigatorio: segredo que assina os logins. Valor aleatorio e longo.
# Trocar este valor desloga todo mundo.
JWT_SECRET=
JWT_EXPIRES_IN=72h

# Logs em arquivo (padrao: backend/logs, ultimos 30 dias). LOG_DIR vazio desliga.
# LOG_DIR=
# LOG_RETENTION_DAYS=30

# Origens aceitas pelo CORS, separadas por virgula.
# Vazio = qualquer origem (recomendado em rede interna; login e por token).
ALLOWED_ORIGINS=
