{
  "name": "gonc-ticket-managment",
  "version": "2.0.0",
  "private": true,
  "description": "Queue Ticket Management - Workspace root",
  "scripts": {
    "setup:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/standalone/setup.ps1",
    "start:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/standalone/start-all.ps1",
    "status:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/standalone/status.ps1",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix frontend test",
    "lint": "npm --prefix frontend run lint"
  }
}
