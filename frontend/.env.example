# Variaveis PUBLICAS do frontend (vao para o JavaScript do navegador).
# Nunca coloque segredos aqui. Todas sao opcionais: sem arquivo .env o
# frontend usa os defaults abaixo.
#
# Para customizar uma maquina: crie frontend/.env.local so com as linhas
# que mudam (vale para dev e build, e nao vai para o git). Mudou? O
# start-frontend refaz o build sozinho.

# URL do backend. Vazio = mesmo host pelo qual o navegador abriu o frontend
# (recomendado: o mesmo build funciona em qualquer IP sem recompilar).
# Ex. fixo: VITE_URL=http://172.30.24.32
VITE_URL=
VITE_PORT_SERVER=3030

# Logo no topo das telas. false = oculta (o conteudo sobe). Padrao: true
VITE_SHOW_LOGO=true

# 1 = desativa o bloqueio de 5s dos botoes (apenas desenvolvimento)
VITE_DEV=0

# 0 = pula a verificacao de login das telas (a API continua exigindo login,
# entao isso so serve para desenvolvimento)
VITE_SYSTEM_AUTH=1
