# Configuracao do modo standalone (Windows, sem Docker).
# Copie para infra/standalone/.env  -- o setup.cmd faz isso sozinho.
# A conexao do backend com o banco fica em backend/.env (DB_IP etc.).

# Caminho do mongod.exe. Vazio = procura em infra\standalone\mongodb\,
# no PATH e em C:\Program Files\MongoDB\Server\<versao>\bin
MONGOD_PATH=

# Pasta dos dados do MongoDB. C:\data\db e o padrao do proprio mongod
# (o mesmo usado ao rodar "mongod" sem parametros). Se o banco atual
# esta em outra pasta, aponte para ela para nao comecar um banco vazio.
MONGO_DBPATH=C:\data\db

# 127.0.0.1 = banco acessivel so desta maquina (recomendado).
# 0.0.0.0 = acessivel pela rede (ex.: Compass de outro PC).
MONGO_BIND_IP=127.0.0.1

# Porta em que o frontend fica disponivel na rede
FRONTEND_PORT=8080
