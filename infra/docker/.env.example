# Copie para infra/docker/.env e ajuste. Lido automaticamente pelo
# docker compose quando executado nesta pasta.

# Usuario root do MongoDB (criado no primeiro start do volume)
DB_USER=admin
DB_PASS=troque-esta-senha
DB_NAME=gonc-queue-manager

# Obrigatorio: segredo que assina os logins (valor aleatorio e longo).
# Para gerar no PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
JWT_SECRET=
JWT_EXPIRES_IN=72h

# Vazio = qualquer origem (recomendado em rede interna; login e por token)
ALLOWED_ORIGINS=

# Portas publicadas na maquina host
FRONTEND_PORT=80
BACKEND_PORT=3030
MONGO_PORT=27017
