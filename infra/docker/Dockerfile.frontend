# Build context: raiz do repositorio (ver docker-compose.yml)
FROM node:22-slim AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
# VITE_URL vazio: o navegador usa o proprio host para achar o backend,
# entao a imagem funciona em qualquer IP sem rebuild.
ARG VITE_PORT_SERVER=3030
ENV VITE_PORT_SERVER=${VITE_PORT_SERVER}
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
